[Unit]
Description=Power BI Column-Level Data Lineage - Unified Service (UI + API)
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/lineage_ui.service
ExecStart=/opt/lineage_ui.service/.venv/bin/python /opt/lineage_ui.service/run.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment="PATH=/opt/lineage_ui.service/.venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
